{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gh3skin.invalid/v1/performance.schema.json",
  "title": "Band performance tables (direction/performance.json)",
  "description": "Action tables, layers, clips, and constants of the band performance player. Clip files: direction/<role>/<clip>.q48.br.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "members",
    "constants"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "members": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "guitarist": {
          "$ref": "library-common.schema.json#/$defs/performanceMember"
        },
        "bassist": {
          "$ref": "library-common.schema.json#/$defs/performanceMember"
        },
        "singer": {
          "$ref": "library-common.schema.json#/$defs/performanceMember"
        },
        "drummer": {
          "$ref": "library-common.schema.json#/$defs/performanceMember"
        }
      }
    },
    "constants": {
      "$ref": "library-common.schema.json#/$defs/constants"
    },
    "sources": {
      "$ref": "library-common.schema.json#/$defs/sources"
    }
  }
}
