{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gh3skin.invalid/v1/character.schema.json",
  "title": "Character description (character.json)",
  "description": "Selects the GH3 rig profile of the character GLB: a fixed profile of the band library or a profile of a character library. The profile also selects the band role.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "library", "profile"],
  "properties": {
    "version": { "const": 1 },
    "library": { "$ref": "common.schema.json#/$defs/packageId" },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
      "examples": ["gh3-guitarist-axel-v1", "gh3-bassist-v1", "gh3-singer-male-v1", "gh3-drummer-v1", "gh3-guitarist-judy-v1"]
    },
    "animations": {
      "description": "An animation set of the character library that has the profile. Absent: the set of the profile.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "hairMaterials": {
      "description": "GLB material names whose triangles use sorted hair transparency.",
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/name" }
    },
    "highway": {
      "description": "Package path of the highway image of the character (PNG; GH3 uses 512 x 1024). The player's highway uses it when the character plays the player's role, as GH3 create_guitarist does. Absent: the default highway.",
      "$ref": "common.schema.json#/$defs/pngPath"
    },
    "bones": {
      "description": "Bones that the character adds to the profile rig (custom hair, skirt, and tail chains). The GLB skin has them with these bind poses (section 9.3 tolerances).",
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/bone" }
    },
    "colliders": {
      "description": "Capsules and spheres on rig bones that the custom chains collide with.",
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/collider" }
    },
    "chains": {
      "description": "Physics joints on the added bones: the solver of the GH3 hair (no spring; gravity, damping, friction, cone, plane, and hinge limits, speed limit).",
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/chain" }
    },
    "skeleton": {
      "description": "The character keeps its own skeleton: the GLB skin joints. The mod retargets the clips of the profile (its animation set and band role) to it with the humanoid map. Without it, the GLB joints are the profile rig.",
      "$ref": "#/$defs/skeleton"
    },
    "face": {
      "description": "Morph target names (GLB mesh extras targetNames) of the face shapes: blink, the mouth shapes a, i, u, e, o, the consonant visemes pp, ff, th, dd, kk, ch, ss, nn, rr (VRChat and Oculus names), and the brow and eye shapes browUp, browDown, squint. All are optional. Needs 'skeleton'.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "blink": { "$ref": "#/$defs/morphName" }, "a": { "$ref": "#/$defs/morphName" }, "i": { "$ref": "#/$defs/morphName" },
        "u": { "$ref": "#/$defs/morphName" }, "e": { "$ref": "#/$defs/morphName" }, "o": { "$ref": "#/$defs/morphName" },
        "pp": { "$ref": "#/$defs/morphName" }, "ff": { "$ref": "#/$defs/morphName" }, "th": { "$ref": "#/$defs/morphName" },
        "dd": { "$ref": "#/$defs/morphName" }, "kk": { "$ref": "#/$defs/morphName" }, "ch": { "$ref": "#/$defs/morphName" },
        "ss": { "$ref": "#/$defs/morphName" }, "nn": { "$ref": "#/$defs/morphName" }, "rr": { "$ref": "#/$defs/morphName" },
        "browUp": { "$ref": "#/$defs/morphName" }, "browDown": { "$ref": "#/$defs/morphName" }, "squint": { "$ref": "#/$defs/morphName" }
      }
    },
    "attachments": {
      "description": "Attachment slot to a library instrument ID (band/band.json member instrument). An absent slot uses the default. The instrument follows the band role that the character plays.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instrument": { "type": "string", "pattern": "^[A-Za-z0-9_]{1,64}$" }
      }
    }
  },
  "$defs": {
    "boneName": {
      "description": "A rig bone: a GH3 bone name, 'bone-' and its 8-digit checksum, the name of an added bone, or a joint of the character's own skeleton.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f]{1,64}$"
    },
    "jointName": {
      "description": "A joint (GLB node name) of the character's own skeleton.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f]{1,64}$"
    },
    "morphName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "skeleton": {
      "type": "object",
      "additionalProperties": false,
      "required": ["humanoid"],
      "properties": {
        "humanoid": {
          "description": "Humanoid role (VRM 1.0 bone names, and the twist bones of the arms) to the joint that has the role. The 15 VRM required roles are required; map the fingers for good fret and strum hands.",
          "type": "object",
          "additionalProperties": false,
          "required": ["hips", "spine", "head", "leftUpperArm", "leftLowerArm", "leftHand", "rightUpperArm", "rightLowerArm", "rightHand", "leftUpperLeg", "leftLowerLeg", "leftFoot", "rightUpperLeg", "rightLowerLeg", "rightFoot"],
          "properties": {
          "hips": { "$ref": "#/$defs/jointName" },
          "spine": { "$ref": "#/$defs/jointName" },
          "chest": { "$ref": "#/$defs/jointName" },
          "upperChest": { "$ref": "#/$defs/jointName" },
          "neck": { "$ref": "#/$defs/jointName" },
          "head": { "$ref": "#/$defs/jointName" },
          "jaw": { "$ref": "#/$defs/jointName" },
          "leftEye": { "$ref": "#/$defs/jointName" },
          "rightEye": { "$ref": "#/$defs/jointName" },
          "leftShoulder": { "$ref": "#/$defs/jointName" },
          "leftUpperArm": { "$ref": "#/$defs/jointName" },
          "leftUpperArmTwist": { "$ref": "#/$defs/jointName" },
          "leftLowerArm": { "$ref": "#/$defs/jointName" },
          "leftLowerArmTwist": { "$ref": "#/$defs/jointName" },
          "leftHand": { "$ref": "#/$defs/jointName" },
          "leftUpperLeg": { "$ref": "#/$defs/jointName" },
          "leftLowerLeg": { "$ref": "#/$defs/jointName" },
          "leftFoot": { "$ref": "#/$defs/jointName" },
          "leftToes": { "$ref": "#/$defs/jointName" },
          "leftThumbMetacarpal": { "$ref": "#/$defs/jointName" },
          "leftThumbProximal": { "$ref": "#/$defs/jointName" },
          "leftThumbDistal": { "$ref": "#/$defs/jointName" },
          "leftIndexProximal": { "$ref": "#/$defs/jointName" },
          "leftIndexIntermediate": { "$ref": "#/$defs/jointName" },
          "leftIndexDistal": { "$ref": "#/$defs/jointName" },
          "leftMiddleProximal": { "$ref": "#/$defs/jointName" },
          "leftMiddleIntermediate": { "$ref": "#/$defs/jointName" },
          "leftMiddleDistal": { "$ref": "#/$defs/jointName" },
          "leftRingProximal": { "$ref": "#/$defs/jointName" },
          "leftRingIntermediate": { "$ref": "#/$defs/jointName" },
          "leftRingDistal": { "$ref": "#/$defs/jointName" },
          "leftLittleProximal": { "$ref": "#/$defs/jointName" },
          "leftLittleIntermediate": { "$ref": "#/$defs/jointName" },
          "leftLittleDistal": { "$ref": "#/$defs/jointName" },
          "rightShoulder": { "$ref": "#/$defs/jointName" },
          "rightUpperArm": { "$ref": "#/$defs/jointName" },
          "rightUpperArmTwist": { "$ref": "#/$defs/jointName" },
          "rightLowerArm": { "$ref": "#/$defs/jointName" },
          "rightLowerArmTwist": { "$ref": "#/$defs/jointName" },
          "rightHand": { "$ref": "#/$defs/jointName" },
          "rightUpperLeg": { "$ref": "#/$defs/jointName" },
          "rightLowerLeg": { "$ref": "#/$defs/jointName" },
          "rightFoot": { "$ref": "#/$defs/jointName" },
          "rightToes": { "$ref": "#/$defs/jointName" },
          "rightThumbMetacarpal": { "$ref": "#/$defs/jointName" },
          "rightThumbProximal": { "$ref": "#/$defs/jointName" },
          "rightThumbDistal": { "$ref": "#/$defs/jointName" },
          "rightIndexProximal": { "$ref": "#/$defs/jointName" },
          "rightIndexIntermediate": { "$ref": "#/$defs/jointName" },
          "rightIndexDistal": { "$ref": "#/$defs/jointName" },
          "rightMiddleProximal": { "$ref": "#/$defs/jointName" },
          "rightMiddleIntermediate": { "$ref": "#/$defs/jointName" },
          "rightMiddleDistal": { "$ref": "#/$defs/jointName" },
          "rightRingProximal": { "$ref": "#/$defs/jointName" },
          "rightRingIntermediate": { "$ref": "#/$defs/jointName" },
          "rightRingDistal": { "$ref": "#/$defs/jointName" },
          "rightLittleProximal": { "$ref": "#/$defs/jointName" },
          "rightLittleIntermediate": { "$ref": "#/$defs/jointName" },
          "rightLittleDistal": { "$ref": "#/$defs/jointName" }
          }
        },
        "followers": {
          "description": "Bones that turn with another bone (MMD append rotation): 'weight' times the rotation of 'source' from its rest pose.",
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["bone", "source", "weight"],
            "properties": {
              "bone": { "$ref": "#/$defs/jointName" },
              "source": { "$ref": "#/$defs/jointName" },
              "weight": { "type": "number", "minimum": -4, "maximum": 4 }
            }
          }
        },
        "instrument": {
          "description": "Where the instrument hangs: the joint whose movement it follows (default: the top spine joint), an offset in metres (runtime coordinates, in the GH3 frame of the chest), and its scale.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bone": { "$ref": "#/$defs/jointName" },
            "offset": { "$ref": "common.schema.json#/$defs/vec3" },
            "scale": { "description": "The size of the instrument and of its distance from the chest. Absent: the arm length of the character against the arm length of the GH3 rig.", "type": "number", "minimum": 0.5, "maximum": 1.5 }
          }
        }
      }
    },
    "bone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "parent", "bind"],
      "properties": {
        "name": { "$ref": "#/$defs/boneName" },
        "parent": { "$ref": "#/$defs/boneName" },
        "bind": {
          "description": "Local bind pose [x, y, z, qx, qy, qz, qw] relative to the parent, in runtime coordinates.",
          "type": "array", "items": { "type": "number" }, "minItems": 7, "maxItems": 7
        }
      }
    },
    "collider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bone", "radius", "a"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "bone": { "$ref": "#/$defs/boneName" },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
        "a": { "$ref": "common.schema.json#/$defs/vec3" },
        "b": { "$ref": "common.schema.json#/$defs/vec3" }
      }
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "joints"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" },
        "colliders": {
          "description": "Names of the colliders that the joints of the chain touch. Absent: all colliders.",
          "type": "array", "maxItems": 32, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$" }
        },
        "bendLimit": {
          "description": "Largest angle (radians) of the chord from the chain start to the chain end from its bind direction. Absent: no limit.",
          "type": "number", "exclusiveMinimum": 0, "maximum": 3.14159
        },
        "joints": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/joint" } }
      }
    },
    "joint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bone", "length", "mass", "friction", "angularDamping"],
      "properties": {
        "bone": { "$ref": "#/$defs/boneName" },
        "parent": { "$ref": "#/$defs/boneName" },
        "length": { "type": "number", "exclusiveMinimum": 0.005, "exclusiveMaximum": 1 },
        "direction": { "$ref": "common.schema.json#/$defs/vec3" },
        "radius": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "mass": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "friction": { "type": "number", "minimum": 0, "maximum": 100 },
        "angularDamping": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxAngularVelocity": { "type": "number", "minimum": 0, "maximum": 1000 },
        "stiffness": { "description": "Pull toward the bind direction against the parent (per second squared). Absent: 0.", "type": "number", "minimum": 0, "maximum": 5000 },
        "drag": { "description": "Damping of the swing against the parent (per second). Absent: 0.", "type": "number", "minimum": 0, "maximum": 100 },
        "gravity": { "description": "Share of gravity. Absent: 1.", "type": "number", "minimum": 0, "maximum": 2 },
        "type": { "enum": ["ragdoll", "hinge"] },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["coneLimit"],
          "properties": {
            "twistLimit": { "$ref": "common.schema.json#/$defs/vec2" },
            "coneLimit": { "$ref": "common.schema.json#/$defs/vec2" },
            "planesLimit": { "$ref": "common.schema.json#/$defs/vec2" }
          }
        },
        "twistAxis": { "$ref": "common.schema.json#/$defs/vec3" },
        "coneAxis": { "$ref": "common.schema.json#/$defs/vec3" },
        "planeAxis": { "$ref": "common.schema.json#/$defs/vec3" },
        "axis": { "$ref": "common.schema.json#/$defs/vec3" },
        "range": { "$ref": "common.schema.json#/$defs/vec2" }
      },
      "if": { "properties": { "type": { "const": "hinge" } }, "required": ["type"] },
      "then": { "required": ["axis", "range"] },
      "else": { "required": ["limits"] }
    }
  }
}
