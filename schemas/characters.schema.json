{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gh3skin.invalid/v1/characters.schema.json",
  "title": "Character library (characters.json)",
  "description": "Rig profiles, animation sets, hair, and IK chains of a character library. Clip files: clips/<clip>.q48.br, local transforms on the clip rig of their animation set (clipRig, or a rig of clipRigs).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "library", "clipRig", "profiles", "animations", "hair", "ik"],
  "properties": {
    "version": { "const": 1 },
    "library": { "$ref": "common.schema.json#/$defs/packageId" },
    "clipRig": {
      "description": "The rig of the clip files of the animation sets without clipRig. A profile plays a clip with the offset (profile rest position - clip rig rest position) on each position track.",
      "$ref": "#/$defs/clipRig"
    },
    "clipRigs": {
      "description": "Other clip rigs, by ID. An animation set with clipRig has its clips on that rig.",
      "type": "object",
      "maxProperties": 16,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/clipRig" }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/profile" }
    },
    "animations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1000,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/animationSet" }
    },
    "hair": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": { "$ref": "library-common.schema.json#/$defs/checksum" },
      "additionalProperties": { "$ref": "#/$defs/hair" }
    },
    "ik": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100,
      "propertyNames": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": { "$ref": "library-common.schema.json#/$defs/ikChain" }
      }
    },
    "constraints": { "$ref": "library-common.schema.json#/$defs/rigConstraints" },
    "sources": { "$ref": "library-common.schema.json#/$defs/sources" }
  },
  "$defs": {
    "clipRig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "bones", "parents", "bind"],
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "bones": { "$ref": "library-common.schema.json#/$defs/bones" },
        "parents": { "$ref": "#/$defs/parents" },
        "bind": { "$ref": "#/$defs/bind" },
        "points": { "$ref": "library-common.schema.json#/$defs/rigPoints" }
      }
    },
    "parents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": { "type": "integer", "minimum": -1, "maximum": 254 }
    },
    "bind": {
      "description": "Local bind transform of each bone: [x, y, z, qx, qy, qz, qw] in runtime coordinates.",
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "type": "number" } }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "name", "outfit", "skeleton", "scale", "animations", "hair", "ik", "bones", "parents", "bind"],
      "properties": {
        "role": { "enum": ["guitarist", "singer"] },
        "name": { "$ref": "common.schema.json#/$defs/name" },
        "outfit": { "type": "integer", "minimum": 1, "maximum": 99 },
        "skeleton": { "$ref": "library-common.schema.json#/$defs/checksum" },
        "scale": { "type": "number", "minimum": 0.25, "maximum": 4 },
        "animations": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "hair": { "oneOf": [{ "$ref": "library-common.schema.json#/$defs/checksum" }, { "type": "null" }] },
        "ik": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "bones": { "$ref": "library-common.schema.json#/$defs/bones" },
        "parents": { "$ref": "#/$defs/parents" },
        "bind": { "$ref": "#/$defs/bind" }
      }
    },
    "animationSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["animSet", "groups", "layers", "clips"],
      "properties": {
        "animSet": { "$ref": "library-common.schema.json#/$defs/checksum" },
        "clipRig": {
          "description": "The ID of the clip rig in clipRigs. Absent: clipRig.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "groups": { "$ref": "library-common.schema.json#/$defs/clipTable" },
        "layers": { "$ref": "library-common.schema.json#/$defs/clipTable" },
        "clips": { "$ref": "library-common.schema.json#/$defs/clips" },
        "missingClips": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "library-common.schema.json#/$defs/checksum" }
        }
      }
    },
    "hair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "joints", "capsule", "ragdoll"],
      "properties": {
        "head": { "type": "integer", "minimum": 0, "maximum": 254 },
        "joints": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/hairJoint" } },
        "capsule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["radius", "a", "b"],
          "properties": {
            "radius": { "type": "number", "minimum": 0 },
            "a": { "$ref": "common.schema.json#/$defs/vec3" },
            "b": { "$ref": "common.schema.json#/$defs/vec3" }
          }
        },
        "ragdoll": { "$ref": "library-common.schema.json#/$defs/checksum" }
      }
    },
    "hairJoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bone", "parent", "mass", "friction", "angularDamping", "position", "rotation", "length"],
      "properties": {
        "bone": { "type": "integer", "minimum": 0, "maximum": 254 },
        "parent": { "type": "integer", "minimum": 0, "maximum": 254 },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["twistLimit", "coneLimit", "planesLimit"],
          "properties": {
            "twistLimit": { "$ref": "common.schema.json#/$defs/vec2" },
            "coneLimit": { "$ref": "common.schema.json#/$defs/vec2" },
            "planesLimit": { "$ref": "common.schema.json#/$defs/vec2" }
          }
        },
        "mass": { "type": "number", "exclusiveMinimum": 0 },
        "friction": { "type": "number", "minimum": 0 },
        "angularDamping": { "type": "number", "minimum": 0 },
        "linearDamping": { "type": "number", "minimum": 0 },
        "position": { "$ref": "common.schema.json#/$defs/vec3" },
        "rotation": { "$ref": "common.schema.json#/$defs/quaternion" },
        "length": { "type": "number", "exclusiveMinimum": 0.005, "exclusiveMaximum": 1 },
        "type": { "enum": ["ragdoll", "hinge", "prismatic"] },
        "axis": { "$ref": "common.schema.json#/$defs/vec3" },
        "range": { "$ref": "common.schema.json#/$defs/vec2" },
        "twistAxis": { "$ref": "common.schema.json#/$defs/vec3" },
        "coneAxis": { "$ref": "common.schema.json#/$defs/vec3" },
        "planeAxis": { "$ref": "common.schema.json#/$defs/vec3" },
        "maxAngularVelocity": { "type": "number", "minimum": 0 }
      },
      "if": { "properties": { "type": { "enum": ["hinge", "prismatic"] } }, "required": ["type"] },
      "then": { "required": ["axis", "range"] },
      "else": { "required": ["limits"] }
    }
  }
}
