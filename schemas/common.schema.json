{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gh3skin.invalid/v1/common.schema.json",
  "title": "Shared definitions of package format v1",
  "$defs": {
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,95}$"
    },
    "semver": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "path": {
      "description": "Package-relative path. Segments use letters, digits, '_', '-', and '.', and do not start with '.'.",
      "type": "string",
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*$"
    },
    "pngPath": {
      "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.png$" }]
    },
    "glbPath": {
      "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.glb$" }]
    },
    "jsonPath": {
      "allOf": [{ "$ref": "#/$defs/path" }, { "pattern": "\\.json$" }]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "optionalName": {
      "type": "string",
      "maxLength": 256
    },
    "number": {
      "type": "number"
    },
    "vec2": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 2
    },
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "vec4": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "quaternion": {
      "description": "Unit quaternion [x, y, z, w]. The validator checks |q| = 1 within 0.001.",
      "$ref": "#/$defs/vec4"
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation"],
      "properties": {
        "position": { "$ref": "#/$defs/vec3" },
        "rotation": { "$ref": "#/$defs/quaternion" }
      }
    },
    "role": {
      "enum": ["guitarist", "bassist", "singer", "drummer"]
    },
    "crowdRole": {
      "type": "string",
      "pattern": "^crowd[1-8]$"
    },
    "textureRef": {
      "description": "Empty (no texture), '#' and the name of an image in the same GLB, or the package path of a pre-encoded texture (GH3TEX02, .tex).",
      "type": "string",
      "maxLength": 257,
      "pattern": "^(|#.{1,256}|[A-Za-z0-9_-][A-Za-z0-9._-]*(/[A-Za-z0-9_-][A-Za-z0-9._-]*)*\\.tex)$"
    }
  }
}
