{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gh3skin.invalid/v1/library-common.schema.json",
  "title": "Shared definitions of the library files",
  "$defs": {
    "checksum": {
      "description": "GH3 checksum: 8 lowercase hex digits.",
      "type": "string",
      "pattern": "^[0-9a-f]{8}$"
    },
    "hash": {
      "description": "SHA-1 or SHA-256 in lowercase hex.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "sources": {
      "description": "Pipeline record: GH3 source file to its hash. The importer ignores it.",
      "type": "object",
      "maxProperties": 10000,
      "additionalProperties": {
        "$ref": "#/$defs/hash"
      }
    },
    "clipIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/checksum"
      }
    },
    "clipTable": {
      "description": "Action or layer name to the clip IDs to choose from.",
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "#/$defs/clipIds"
      }
    },
    "clipInfo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "frames",
        "rootDistance"
      ],
      "properties": {
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "frames": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "rootDistance": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "clips": {
      "description": "Clip ID to its timing.",
      "type": "object",
      "maxProperties": 10000,
      "propertyNames": {
        "$ref": "#/$defs/checksum"
      },
      "additionalProperties": {
        "$ref": "#/$defs/clipInfo"
      }
    },
    "bones": {
      "description": "Rig bone checksums in rig order.",
      "type": "array",
      "minItems": 1,
      "maxItems": 255,
      "items": {
        "$ref": "#/$defs/checksum"
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bones",
        "groups",
        "layers",
        "clips"
      ],
      "properties": {
        "profile": {
          "description": "The ID of the fixed profile of the role (character.json and instrument.json profile).",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "bones": {
          "$ref": "#/$defs/bones"
        },
        "groups": {
          "$ref": "#/$defs/clipTable"
        },
        "layers": {
          "$ref": "#/$defs/clipTable"
        },
        "clips": {
          "$ref": "#/$defs/clips"
        },
        "points": {
          "$ref": "#/$defs/rigPoints"
        },
        "ik": {
          "$ref": "#/$defs/ikChains"
        }
      }
    },
    "performanceMember": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bones",
        "groups",
        "layers",
        "clips"
      ],
      "properties": {
        "bones": {
          "$ref": "#/$defs/bones"
        },
        "groups": {
          "$ref": "#/$defs/clipTable"
        },
        "layers": {
          "$ref": "#/$defs/clipTable"
        },
        "clips": {
          "$ref": "#/$defs/clips"
        },
        "missingClips": {
          "description": "Clip IDs that the GH3 tables name but the GH3 data does not contain.",
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/checksum"
          }
        },
        "walking": {
          "$ref": "#/$defs/walking"
        }
      }
    },
    "walking": {
      "description": "The scalars of the GH3 walking struct of the set (degrees and degrees per second; min_turn: the angle from the back within which the performer walks backward). Absent: the set has no own walk.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_turn": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "max_turn": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "turn_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        },
        "face_audience_speed": {
          "type": "number",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "constants": {
      "type": "object",
      "maxProperties": 1000,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "number"
      }
    },
    "modelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_]{1,64}$"
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rigPoints": {
      "description": "The bones of a rig by their use (PACKAGE-FORMAT.md section 10.2). Each value is a bone of the rig.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "instrument": {
          "$ref": "#/$defs/checksum"
        },
        "microphone": {
          "$ref": "#/$defs/checksum"
        },
        "mouthUpper": {
          "$ref": "#/$defs/checksum"
        },
        "mouthLower": {
          "$ref": "#/$defs/checksum"
        },
        "stickLeft": {
          "$ref": "#/$defs/checksum"
        },
        "stickRight": {
          "$ref": "#/$defs/checksum"
        },
        "seat": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "ikChain": {
      "description": "One chain of a GH3 IK parameter array: bone0-2, boneTarget, HingeAxis, CosMaxHingeAngle, CosMinHingeAngle. hand: the arm of the chain (right: the strum arm, left: the fret arm); absent for a leg.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bones",
        "target",
        "hinge",
        "cosMax",
        "cosMin"
      ],
      "properties": {
        "bones": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/checksum"
          }
        },
        "target": {
          "$ref": "#/$defs/checksum"
        },
        "hinge": {
          "$ref": "common.schema.json#/$defs/vec3"
        },
        "cosMax": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "cosMin": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "hand": {
          "enum": [
            "right",
            "left"
          ]
        }
      }
    },
    "ikChains": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/ikChain"
      }
    },
    "rigConstraints": {
      "description": "GH3 hero_ConstraintBones: twist and split bones that follow a target bone by an amount.",
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "bone",
          "target",
          "amount"
        ],
        "properties": {
          "type": {
            "enum": [
              "Split",
              "SplitR",
              "Twist",
              "TwistChild"
            ]
          },
          "bone": {
            "$ref": "#/$defs/checksum"
          },
          "target": {
            "$ref": "#/$defs/checksum"
          },
          "amount": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
