{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.gh3skin.invalid/v1/lighting.schema.json",
  "title": "Venue lighting bank (lighting.json)",
  "description": "Lights, snapshots, moods, and color presets. Unity runtime coordinates. Every snapshot lists every light in the order of 'lights' and the same beam IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "lights", "snapshots", "moods", "colors"],
  "properties": {
    "version": { "const": 1 },
    "lights": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "type", "position", "rotation"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/name" },
          "object": { "$ref": "common.schema.json#/$defs/name" },
          "group": { "$ref": "common.schema.json#/$defs/name" },
          "type": { "enum": ["Ambient", "Dir", "Point", "Spot"] },
          "position": { "$ref": "common.schema.json#/$defs/vec3" },
          "rotation": { "$ref": "common.schema.json#/$defs/quaternion" },
          "overrideColor": { "type": "boolean" },
          "hotspot": { "type": "number", "minimum": 0, "maximum": 180 },
          "field": { "type": "number", "minimum": 0, "maximum": 180 }
        }
      }
    },
    "snapshots": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 4096,
      "propertyNames": { "$ref": "common.schema.json#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lights", "beams"],
        "properties": {
          "lights": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["color", "intensity", "near", "far"],
              "properties": {
                "color": { "$ref": "common.schema.json#/$defs/vec3" },
                "intensity": { "type": "number", "minimum": -100, "maximum": 100 },
                "near": { "type": "number", "minimum": 0, "maximum": 100000 },
                "far": { "type": "number", "minimum": 0, "maximum": 100001 },
                "specular": { "type": "number" },
                "inherit": { "type": "boolean" }
              }
            }
          },
          "beams": {
            "type": "object",
            "maxProperties": 1024,
            "propertyNames": { "$ref": "common.schema.json#/$defs/name" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["position", "rotation", "color", "density", "startRadius", "endRadius", "range"],
              "properties": {
                "position": { "$ref": "common.schema.json#/$defs/vec3" },
                "rotation": { "$ref": "common.schema.json#/$defs/quaternion" },
                "color": { "$ref": "common.schema.json#/$defs/vec3" },
                "density": { "type": "number", "minimum": 0, "maximum": 100000 },
                "startRadius": { "type": "number", "minimum": 0, "maximum": 100000 },
                "endRadius": { "type": "number", "minimum": 0, "maximum": 100000 },
                "range": { "type": "number", "minimum": 0, "maximum": 100000 },
                "inherit": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "moods": {
      "type": "object",
      "required": ["intro", "blackout"],
      "propertyNames": { "enum": ["intro", "verse", "chorus", "solo", "flare", "blackout", "strobe"] },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 256,
        "items": { "$ref": "common.schema.json#/$defs/name" }
      }
    },
    "colors": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,31}$" },
      "additionalProperties": { "$ref": "common.schema.json#/$defs/vec3" }
    }
  }
}
