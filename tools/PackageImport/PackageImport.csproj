<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net6.0: the importer runs on the .NET 6 runtime that MelonLoader ships with Clone Hero. -->
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <RollForward>Major</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Packages/*.cs" Exclude="../../src/Packages/PackageRuntime.cs" Link="Packages/%(Filename)%(Extension)" />
    <Compile Include="../../src/Gh3/Gh3Checksum.cs" Link="Gh3/Gh3Checksum.cs" />
    <Compile Include="../../src/SkinEnvironment.cs" Link="SkinEnvironment.cs" />
    <Compile Include="../../src/Stage/Band/StageHair.cs" Link="Stage/StageHair.cs" />
    <Compile Include="../../src/Stage/Band/StageHair.Collision.cs" Link="Stage/StageHair.Collision.cs" />
    <Compile Include="../../src/Stage/Band/HairDefinition.cs" Link="Stage/HairDefinition.cs" />
    <Compile Include="../../src/Stage/StageLimits.cs" Link="Stage/StageLimits.cs" />
    <Compile Include="../../src/Stage/StageTolerance.cs" Link="Stage/StageTolerance.cs" />
    <Compile Include="../../src/Stage/Band/BandAnimation.cs" Link="Stage/BandAnimation.cs" />
  </ItemGroup>
</Project>
