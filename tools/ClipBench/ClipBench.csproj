<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net6.0 so the bench runs on the .NET 6 runtime that MelonLoader ships with Clone Hero. -->
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Optimize>true</Optimize>
    <RollForward>Major</RollForward>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ZstdSharp.Port" Version="0.8.7" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../src/Gh3/*.cs" Link="Gh3/%(Filename)%(Extension)" />
    <Compile Include="../../src/Packages/*.cs" Exclude="../../src/Packages/PackageRuntime.cs" Link="Packages/%(Filename)%(Extension)" />
    <Compile Include="../../src/Stage/Direction/StageTimeline.cs" Link="StageTimeline.cs" />
    <Compile Include="../../src/Stage/Direction/StageCue.cs" Link="StageCue.cs" />
    <Compile Include="../../src/Stage/Direction/StageCameraPath.cs" Link="StageCameraPath.cs" />
    <Compile Include="../../src/Stage/Band/BandAnimation.cs" Link="BandAnimation.cs" />
    <Compile Include="../../src/Stage/Band/StageDrummer.cs" Link="StageDrummer.cs" />
    <Compile Include="../../src/Stage/Band/StageGuitarArms.cs" Link="StageGuitarArms.cs" />
    <Compile Include="../../src/Stage/Band/StagePerformance.cs" Link="StagePerformance.cs" />
    <Compile Include="../../src/Stage/Band/LyricPhonemes.cs" Link="LyricPhonemes.cs" />
    <Compile Include="../../src/Stage/Band/VocalEnvelope.cs" Link="VocalEnvelope.cs" />
    <Compile Include="../../src/Stage/Band/StageLipSync.Life.cs" Link="StageLipSync.Life.cs" />
    <Compile Include="../../src/Stage/Band/StageLipSync.Track.cs" Link="StageLipSync.Track.cs" />
    <Compile Include="../../src/Stage/StageTolerance.cs" Link="StageTolerance.cs" />
    <Compile Include="../../src/Stage/Direction/StageRockBandVenue.cs" Link="StageRockBandVenue.cs" />
    <Compile Include="../../src/Stage/StageLimits.cs" Link="StageLimits.cs" />
    <Compile Include="../../src/Stage/Band/StageHair.cs" Link="StageHair.cs" />
    <Compile Include="../../src/Stage/Band/StageHair.Collision.cs" Link="StageHair.Collision.cs" />
    <Compile Include="../../src/SkinEnvironment.cs" Link="SkinEnvironment.cs" />
    <Compile Include="../../src/Stage/Direction/Gh3NoteConstants.cs" Link="Gh3NoteConstants.cs" />
    <Compile Include="../../src/Stage/Band/HairDefinition.cs" Link="HairDefinition.cs" />
    <Compile Include="../../src/Stage/Band/StageLipSync.cs" Link="StageLipSync.cs" />
    <Compile Include="../../src/Stage/Band/StageLipSync.Shapes.cs" Link="StageLipSync.Shapes.cs" />
    <Compile Include="../../src/Stage/Band/PerformanceClip.cs" Link="PerformanceClip.cs" />
    <Compile Include="../../src/Stage/Band/CharacterMotion.cs" Link="CharacterMotion.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../src/Resources/cmudict.br" LogicalName="Gh3Skin.cmudict.br" />
  </ItemGroup>
</Project>
